{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "g++.exe - Собрать и отладить активный файл",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            // ★★★★★ ВОТ ЭТА СТРОКА ★★★★★
            "externalConsole": true,  // <-- Меняем false на true
            // ★★★★★★★★★★★★★★★★★★★★
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe", // Путь к вашему gdb
            "setupCommands": [
                {
                    "description": "Включить красивое отображение для gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++.exe build active file" // Должно совпадать с label в tasks.json
        }
    ]
}